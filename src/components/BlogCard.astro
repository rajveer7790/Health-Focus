---
import { formatDateShort } from "../utils/formatDate";
import { formatReadingTime } from "../utils/readingTime";
import { CATEGORIES } from "../utils/seo";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    title: string;
    description: string;
    slug: string;
    category: string;
    pubDate: Date;
    readingTime: number;
    image?: string | ImageMetadata;
    author?: string;
    // Deprecating variant for unified design, but keeping optional for backward compat if needed temporarily
    variant?: "regular" | "overlay" | "compact";
}

const {
    title,
    description,
    slug,
    category,
    pubDate,
    image,
    author = "Health Focus Team",
} = Astro.props;

const categoryInfo = CATEGORIES.find((cat) => cat.slug === category);

// Generate initials for author avatar placeholder
const getInitials = (name: string) => {
    return name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .substring(0, 2)
        .toUpperCase();
};
---

<article
    class="group flex flex-col h-full bg-neutral-50 dark:bg-neutral-900 rounded-2xl overflow-hidden border border-neutral-100 dark:border-neutral-800 shadow-sm hover:shadow-md transition-shadow duration-300"
>
    <a href={`/blog/${slug}`} class="block flex-1 flex flex-col h-full">
        {/* Image Section */}
        <div
            class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-200 dark:bg-neutral-800"
        >
            {
                image &&
                    (typeof image === "string" ? (
                        <img
                            src={image}
                            alt={title}
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                            loading="lazy"
                        />
                    ) : (
                        <Image
                            src={image}
                            alt={title}
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                            widths={[400, 640]}
                            sizes="(max-width: 768px) 100vw, 400px"
                        />
                    ))
            }

            {
                /* Category Pill Overlay (Optional: could be inside body too, but reference has it separate or near content. Reference image shows pills below image) */
            }
        </div>

        {/* Content Section */}
        <div class="flex flex-col flex-1 p-4 md:p-6">
            {/* Category Pills */}
            {
                categoryInfo && (
                    <div class="flex items-center gap-2 mb-2 md:mb-3">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] md:text-xs font-semibold bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                            {categoryInfo.name}
                        </span>
                    </div>
                )
            }

            {/* Title */}
            <h3
                class="font-display font-bold text-lg md:text-xl mb-2 md:mb-3 text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2"
            >
                {title}
            </h3>

            {/* Description */}
            <p
                class="text-neutral-600 dark:text-neutral-400 text-xs md:text-sm mb-4 md:mb-6 line-clamp-3 flex-1"
            >
                {description}
            </p>

            {/* Footer: Author & Date */}
            <div
                class="flex items-center justify-between mt-auto pt-4 border-t border-neutral-200 dark:border-neutral-800"
            >
                <div class="flex items-center gap-2.5">
                    <div
                        class="w-8 h-8 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center text-white text-xs font-bold"
                    >
                        {getInitials(author)}
                    </div>
                    <div class="flex flex-col">
                        <span
                            class="text-xs font-semibold text-neutral-900 dark:text-neutral-200"
                        >
                            {author}
                        </span>
                        <span
                            class="text-[10px] text-neutral-500 dark:text-neutral-400"
                        >
                            {formatDateShort(pubDate)}
                        </span>
                    </div>
                </div>

                {/* Bookmark/Save Icon (Decorative as per reference) */}
                <div class="text-neutral-400 dark:text-neutral-600">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>
    </a>
</article>
