---
import { formatDateShort } from "../utils/formatDate";
import { formatReadingTime } from "../utils/readingTime";
import { CATEGORIES } from "../utils/seo";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    title: string;
    description: string;
    slug: string;
    category: string;
    pubDate: Date;
    readingTime: number;
    image?: string | ImageMetadata;
    variant?: "regular" | "overlay" | "compact";
}

const {
    title,
    description,
    slug,
    category,
    pubDate,
    readingTime,
    image,
    variant = "regular",
} = Astro.props;

const categoryInfo = CATEGORIES.find((cat) => cat.slug === category);
---

{
    variant === "overlay" && (
        <article class="card group relative h-full min-h-[400px] overflow-hidden rounded-3xl">
            <a href={`/blog/${slug}`} class="block h-full">
                {image && (
                    <div class="absolute inset-0">
                        {typeof image === "string" ? (
                            <img
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                                loading="eager"
                            />
                        ) : (
                            <Image
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                                loading="eager"
                                fetchpriority="high"
                                widths={[640, 768, 1024, 1280, 1600]}
                                sizes="(max-width: 1024px) 100vw, 800px"
                            />
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />
                    </div>
                )}

                <div class="relative h-full flex flex-col justify-end p-8">
                    {categoryInfo && (
                        <div class="flex items-center gap-2 mb-3">
                            <span class="text-white fill-current">
                                {categoryInfo.icon}
                            </span>
                            <span class="text-xs font-bold uppercase tracking-wider text-white">
                                {categoryInfo.name}
                            </span>
                        </div>
                    )}

                    <h3 class="font-display font-bold text-2xl md:text-4xl text-white mb-3 leading-tight text-balance group-hover:underline decoration-2 underline-offset-4">
                        {title}
                    </h3>

                    <p class="text-neutral-200 line-clamp-2 md:line-clamp-3 mb-4 max-w-xl text-lg">
                        {description}
                    </p>
                </div>
            </a>
        </article>
    )
}

{
    variant === "compact" && (
        <article class="group flex flex-col h-full">
            <a href={`/blog/${slug}`} class="block flex-1 flex flex-col">
                {image && (
                    <div class="relative overflow-hidden aspect-[4/3] rounded-xl mb-4">
                        {typeof image === "string" ? (
                            <img
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        ) : (
                            <Image
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                                widths={[320, 480, 640]}
                                sizes="(max-width: 640px) 100vw, 320px"
                            />
                        )}
                    </div>
                )}

                <div class="flex flex-col flex-1">
                    {categoryInfo && (
                        <span
                            class={`text-[10px] uppercase font-bold tracking-wider text-${categoryInfo.color}-600 mb-2`}
                        >
                            {categoryInfo.name}
                        </span>
                    )}

                    <h3 class="font-display font-bold text-lg leading-snug mb-2 text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-3">
                        {title}
                    </h3>
                </div>
            </a>
        </article>
    )
}

{
    variant === "regular" && (
        <article class="card card-hover group h-full flex flex-col bg-white dark:bg-neutral-800 border-neutral-100 dark:border-neutral-700">
            <a href={`/blog/${slug}`} class="block flex-1 flex flex-col">
                {image && (
                    <div class="relative overflow-hidden aspect-video">
                        {typeof image === "string" ? (
                            <img
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        ) : (
                            <Image
                                src={image}
                                alt={title}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                                widths={[480, 640, 768, 1024]}
                                sizes="(max-width: 768px) 100vw, 480px"
                            />
                        )}
                    </div>
                )}

                <div class="p-6 flex flex-col flex-1">
                    {categoryInfo && (
                        <div class="flex items-center gap-2 mb-3">
                            <span class="text-base">{categoryInfo.icon}</span>
                            <span
                                class={`text-xs font-semibold uppercase tracking-wider text-${categoryInfo.color}-600`}
                            >
                                {categoryInfo.name}
                            </span>
                        </div>
                    )}

                    <h3 class="font-display font-bold text-xl mb-3 text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {title}
                    </h3>

                    <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-4 line-clamp-3">
                        {description}
                    </p>
                </div>
            </a>
        </article>
    )
}
