---
import { formatDateShort } from "../utils/formatDate";
import { formatReadingTime } from "../utils/readingTime";
import { CATEGORIES } from "../utils/seo";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    title: string;
    description: string;
    slug: string;
    category: string;
    pubDate: Date;
    readingTime: number;
    image?: string | ImageMetadata;
    author?: string;
    // Deprecating variant for unified design, but keeping optional for backward compat if needed temporarily
    variant?: "regular" | "overlay" | "compact";
}

const {
    title,
    description,
    slug,
    category,
    pubDate,
    image,
    author = "Health Focus Team",
} = Astro.props;

const categoryInfo = CATEGORIES.find((cat) => cat.slug === category);

// Generate initials for author avatar placeholder
const getInitials = (name: string) => {
    return name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .substring(0, 2)
        .toUpperCase();
};
---

<article
    class="group flex flex-col h-full bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800 pb-8 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors"
>
    <a href={`/blog/${slug}/`} class="block flex-1 flex flex-col h-full">
        {/* Image Section */}
        <div class="relative w-full aspect-[16/10] overflow-hidden mb-4">
            {
                image &&
                    (typeof image === "string" ? (
                        <img
                            src={image}
                            alt={title}
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                            loading="lazy"
                        />
                    ) : (
                        <Image
                            src={image}
                            alt={title}
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                            widths={[300, 400]}
                            sizes="(max-width: 768px) 100vw, 400px"
                        />
                    ))
            }
        </div>

        {/* Content Section */}
        <div class="flex flex-col flex-1">
            {/* Category */}
            <div class="mb-2">
                <span
                    class="text-xs font-bold uppercase tracking-wider text-primary-700 dark:text-primary-400"
                >
                    {categoryInfo?.name || category}
                </span>
            </div>

            {/* Title */}
            <h3
                class="font-display font-bold text-xl md:text-2xl mb-3 text-neutral-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-400 transition-colors leading-tight"
            >
                {title}
            </h3>

            {/* Description */}
            <p
                class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base mb-4 line-clamp-3 leading-relaxed"
            >
                {description}
            </p>

            {/* Footer: Author & Date */}
            <div
                class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-500 mt-auto font-medium"
            >
                <span
                    class="text-neutral-900 dark:text-neutral-300 uppercase tracking-wide"
                >
                    {author}
                </span>
                <span>•</span>
                <span>
                    {formatDateShort(pubDate)}
                </span>
            </div>
        </div>
    </a>
</article>
