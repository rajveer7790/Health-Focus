---
import { CATEGORIES } from "../utils/seo";
import { Image } from "astro:assets";
import logoImage from "../assets/images/logo.png";

const currentPath = Astro.url.pathname;

const today = new Date();
const dateString = today.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<header class="relative bg-white dark:bg-neutral-900 z-50">
  <!-- Top Bar: Logo, Date, Utilities -->
  <div class="border-b border-neutral-200 dark:border-neutral-800">
    <div class="container-custom py-3 md:py-4">
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-4 md:gap-0"
      >
        <!-- Mobile: Hamburger + Logo -->
        <div class="flex items-center justify-between w-full md:w-auto">
          <button
            id="mobile-menu-button"
            class="md:hidden p-2 -ml-2 text-neutral-900 dark:text-white"
            aria-label="Toggle menu"
          >
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <a href="/" class="flex items-center gap-3 group">
            <Image
              src={logoImage}
              alt="Health Focus Logo"
              class="w-10 h-10 md:w-12 md:h-12 object-contain"
              width={80}
              height={80}
              loading="eager"
            />
            {
              currentPath === "/" ? (
                <h1 class="font-display font-bold text-3xl md:text-4xl tracking-tighter text-primary-600 dark:text-primary-500">
                  Health Focus
                </h1>
              ) : (
                <span class="font-display font-bold text-3xl md:text-4xl tracking-tighter text-primary-600 dark:text-primary-500">
                  Health Focus
                </span>
              )
            }
          </a>
        </div>

        <!-- Desktop: Date & Utilities -->
        <div class="hidden md:flex items-center gap-6">
          <span
            class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
          >
            {dateString}
          </span>
          <div class="h-4 w-px bg-neutral-300 dark:bg-neutral-700"></div>
          <div class="flex items-center gap-4">
            <button
              id="dark-mode-toggle"
              class="p-2 text-neutral-700 dark:text-neutral-300 hover:text-primary-600 transition-colors"
              aria-label="Toggle dark mode"
            >
              <svg
                class="w-5 h-5 hidden dark:block"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                ></path></svg
              >
              <svg
                class="w-5 h-5 dark:hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                ></path></svg
              >
            </button>
            <a
              href="#newsletter"
              class="bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-4 py-2 text-xs font-bold uppercase tracking-wider hover:bg-primary-600 dark:hover:bg-neutral-200 transition-colors"
            >
              Subscribe
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Navigation (Sticky) -->
  <div
    class="sticky top-0 z-40 bg-primary-600 dark:bg-neutral-800 text-white shadow-md"
  >
    <div class="container-custom">
      <nav class="hidden md:flex items-center">
        <!-- Home Link -->
        <a
          href="/"
          class={`px-4 py-3 text-sm font-bold uppercase tracking-wider border-b-4 transition-colors ${currentPath === "/" ? "border-white bg-primary-700 dark:bg-neutral-700" : "border-transparent hover:bg-primary-700 dark:hover:bg-neutral-700 hover:border-primary-400"}`}
        >
          News Home
        </a>

        <!-- Categories -->
        {
          CATEGORIES.slice(0, 8).map((category) => (
            <a
              href={`/category/${category.slug}/`}
              class={`px-4 py-3 text-sm font-bold uppercase tracking-wider border-b-4 transition-colors ${currentPath.includes(category.slug) ? "border-white bg-primary-700 dark:bg-neutral-700" : "border-transparent hover:bg-primary-700 dark:hover:bg-neutral-700 hover:border-primary-400"}`}
            >
              {category.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="hidden fixed inset-0 z-50 bg-white dark:bg-neutral-900 overflow-y-auto"
  >
    <div
      class="p-4 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between"
    >
      <span
        class="font-display font-bold text-2xl text-primary-600 dark:text-primary-500"
        >Menu</span
      >
      <button
        id="close-mobile-menu"
        class="p-2 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
      >
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <div class="p-4">
      <div class="flex flex-col gap-1">
        <a
          href="/"
          class="block px-4 py-3 text-lg font-bold border-b border-neutral-100 dark:border-neutral-800 text-neutral-900 dark:text-white"
          >Home</a
        >
        {
          CATEGORIES.map((category) => (
            <a
              href={`/category/${category.slug}/`}
              class="block px-4 py-3 text-lg font-medium border-b border-neutral-100 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400"
            >
              {category.name}
            </a>
          ))
        }
        <a
          href="/about/"
          class="block px-4 py-3 text-lg font-bold text-neutral-900 dark:text-white"
          >About Us</a
        >
        <a
          href="/contact/"
          class="block px-4 py-3 text-lg font-bold text-neutral-900 dark:text-white"
          >Contact</a
        >
      </div>

      <div class="mt-8 px-4">
        <button
          id="dark-mode-toggle-mobile"
          class="w-full py-3 border border-neutral-300 dark:border-neutral-700 rounded-none flex items-center justify-center gap-2 font-bold uppercase text-sm mb-4"
        >
          <svg
            class="w-5 h-5 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path></svg
          >
          <svg
            class="w-5 h-5 dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path></svg
          >
          <span>Toggle Theme</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function setupInteractivity() {
    // Theme Toggle
    const themeToggles = document.querySelectorAll(
      "#dark-mode-toggle, #dark-mode-toggle-mobile",
    );
    const html = document.documentElement;

    themeToggles.forEach((toggle) => {
      // Clone to remove old listeners
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(newToggle, toggle);

      newToggle.addEventListener("click", () => {
        const isDark = html.classList.contains("dark");
        const nextTheme = isDark ? "light" : "dark";
        html.classList.toggle("dark");
        localStorage.setItem("theme", nextTheme);
      });
    });

    // Mobile Menu
    const menuBtn = document.getElementById("mobile-menu-button");
    const closeBtn = document.getElementById("close-mobile-menu");
    const menu = document.getElementById("mobile-menu");

    if (menuBtn && menu) {
      const newMenuBtn = menuBtn.cloneNode(true);
      menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
      newMenuBtn.addEventListener("click", () =>
        menu.classList.remove("hidden"),
      );
    }

    if (closeBtn && menu) {
      const newCloseBtn = closeBtn.cloneNode(true);
      closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
      newCloseBtn.addEventListener("click", () => menu.classList.add("hidden"));
    }
  }

  setupInteractivity();
  document.addEventListener("astro:after-swap", setupInteractivity);
</script>
