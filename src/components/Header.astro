---
import { CATEGORIES } from "../utils/seo";

import { Image } from "astro:assets";
import logoImage from "../assets/images/logo.png";

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 bg-white dark:bg-neutral-900 border-b-2 border-primary-600 dark:border-primary-500"
>
  <nav class="container-custom">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <Image
          src={logoImage}
          alt="Health Focus Logo"
          class="w-10 h-10 object-contain transform group-hover:scale-110 transition-transform"
          width={80}
          height={80}
          loading="eager"
        />
        <span
          class="font-display font-bold text-2xl md:text-3xl tracking-tight text-neutral-900 dark:text-white"
        >
          Health Focus
        </span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a
          href="/"
          class={`font-bold uppercase tracking-wide text-sm transition-colors decoration-2 underline-offset-4 ${currentPath === "/" ? "text-primary-700 underline" : "text-neutral-900 hover:underline hover:text-primary-700 dark:text-white dark:hover:text-primary-400"}`}
        >
          Home
        </a>
        <a
          href="/blog"
          class={`font-bold uppercase tracking-wide text-sm transition-colors decoration-2 underline-offset-4 ${currentPath.startsWith("/blog") ? "text-primary-700 underline" : "text-neutral-900 hover:underline hover:text-primary-700 dark:text-white dark:hover:text-primary-400"}`}
        >
          Blog
        </a>

        <!-- Categories Dropdown -->
        <div class="relative group">
          <button
            class="font-bold uppercase tracking-wide text-sm text-neutral-900 dark:text-white hover:text-primary-700 dark:hover:text-primary-400 transition-colors flex items-center gap-1"
          >
            Categories
            <svg
              class="w-4 h-4 transition-transform group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="absolute top-full left-0 mt-0 w-56 bg-white dark:bg-neutral-900 border border-neutral-900 dark:border-neutral-700 shadow-none opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 p-0"
          >
            <div class="flex flex-col">
              {
                CATEGORIES.map((category) => (
                  <a
                    href={`/category/${category.slug}`}
                    class="flex items-center gap-3 px-6 py-4 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors border-b border-neutral-100 dark:border-neutral-800 last:border-none"
                  >
                    <span class="font-bold text-sm text-neutral-900 dark:text-white">
                      {category.name}
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a
          href="/about"
          class={`font-bold uppercase tracking-wide text-sm transition-colors decoration-2 underline-offset-4 ${currentPath === "/about" ? "text-primary-700 underline" : "text-neutral-900 hover:underline hover:text-primary-700 dark:text-white dark:hover:text-primary-400"}`}
        >
          About
        </a>
        <a
          href="/contact"
          class={`font-bold uppercase tracking-wide text-sm transition-colors decoration-2 underline-offset-4 ${currentPath === "/contact" ? "text-primary-700 underline" : "text-neutral-900 hover:underline hover:text-primary-700 dark:text-white dark:hover:text-primary-400"}`}
        >
          Contact
        </a>
      </div>

      <!-- Right side: Dark Mode Toggle + Subscribe Button -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Dark Mode Toggle -->
        <button
          id="dark-mode-toggle"
          class="p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode to switch to light) -->
          <svg
            class="w-5 h-5 text-yellow-500 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Moon icon (shown in light mode to switch to dark) -->
          <svg
            class="w-5 h-5 text-neutral-700 dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <!-- Subscribe Button -->
        <a
          href="#newsletter"
          class="px-5 py-2 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm tracking-wide uppercase hover:bg-primary-700 dark:hover:bg-neutral-200 transition-colors"
        >
          Subscribe
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          class="w-6 h-6 text-neutral-700 dark:text-neutral-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 animate-slide-down">
      <div class="flex flex-col gap-2">
        <a
          href="/"
          class="px-4 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium text-neutral-700 dark:text-neutral-300"
          >Home</a
        >
        <a
          href="/blog"
          class="px-4 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium text-neutral-700 dark:text-neutral-300"
          >Blog</a
        >

        <div class="px-4 py-2">
          <p
            class="text-sm font-semibold text-neutral-500 dark:text-neutral-400 mb-2"
          >
            Categories
          </p>
          <div class="flex flex-col gap-1 pl-2">
            {
              CATEGORIES.map((category) => (
                <a
                  href={`/category/${category.slug}`}
                  class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                >
                  <span class="text-xl">{category.icon}</span>
                  <span class="text-sm text-neutral-700 dark:text-neutral-300">
                    {category.name}
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <a
          href="/about"
          class="px-4 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium text-neutral-700 dark:text-neutral-300"
          >About</a
        >
        <a
          href="/contact"
          class="px-4 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium text-neutral-700 dark:text-neutral-300"
          >Contact</a
        >

        <!-- Dark Mode Toggle for Mobile -->
        <button
          id="dark-mode-toggle-mobile"
          class="mx-4 px-4 py-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium text-neutral-700 dark:text-neutral-300 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <svg
            class="w-5 h-5 dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <span class="dark:hidden">Dark Mode</span>
          <span class="hidden dark:block">Light Mode</span>
        </button>

        <a href="#newsletter" class="btn btn-primary mx-4 mt-2">Subscribe</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  // Simple, robust toggle logic
  function setupThemeToggles() {
    const themeToggles = document.querySelectorAll(
      "#dark-mode-toggle, #dark-mode-toggle-mobile",
    );
    const html = document.documentElement;

    themeToggles.forEach((toggle) => {
      // Clone to remove old event listeners if any (safety)
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(newToggle, toggle);

      newToggle.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isDark = html.classList.contains("dark");
        const nextTheme = isDark ? "light" : "dark";

        if (nextTheme === "dark") {
          html.classList.add("dark");
        } else {
          html.classList.remove("dark");
        }

        localStorage.setItem("theme", nextTheme);
      });
    });

    // Mobile menu logic
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuButton && mobileMenu) {
      const newMenuButton = menuButton.cloneNode(true);
      menuButton.parentNode.replaceChild(newMenuButton, menuButton);

      newMenuButton.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    }
  }

  // Run immediately
  setupThemeToggles();

  // Re-run on view transitions if they exist
  document.addEventListener("astro:after-swap", setupThemeToggles);
</script>
