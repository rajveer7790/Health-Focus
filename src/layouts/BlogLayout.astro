---
import BaseLayout from "./BaseLayout.astro";
import Newsletter from "../components/Newsletter.astro";
import NewsCard from "../components/NewsCard.astro";
import { formatDate } from "../utils/formatDate";
import { generateArticleSchema } from "../utils/schema";
import { toAbsoluteUrl } from "../utils/seo";
import { getRelatedPosts } from "../utils/relatedPosts";
import { calculateReadingTime } from "../utils/readingTime";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    category: string;
    tags: string[];
    image?: string | ImageMetadata;
  };
  headings: { depth: number; text: string; slug: string }[];
  readingTime: number;
  relatedPosts?: any[];
}

const { frontmatter, headings, readingTime, relatedPosts = [] } = Astro.props;

const articleImage = toAbsoluteUrl(
  typeof frontmatter.image === "string"
    ? frontmatter.image
    : frontmatter.image?.src,
);

const schema = generateArticleSchema({
  title: frontmatter.title,
  description: frontmatter.description,
  image: articleImage,
  datePublished: frontmatter.pubDate.toISOString(),
  dateModified:
    frontmatter.updatedDate?.toISOString() || frontmatter.pubDate.toISOString(),
  author: frontmatter.author,
});
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={articleImage}
  article={true}
  publishedTime={frontmatter.pubDate.toISOString()}
  modifiedTime={frontmatter.updatedDate?.toISOString() || frontmatter.pubDate.toISOString()}
  author={frontmatter.author}
  tags={frontmatter.tags}
  schema={schema}
>
  <article class="pt-8 pb-16">
    <!-- Header -->
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
        <!-- Sidebar (Table of Contents + Disclaimer) -->
        <aside class="lg:w-1/4 order-2 lg:order-1 pt-2 lg:pt-0">
          <div class="sticky top-24 space-y-6">
            <!-- Medical Disclaimer (High priority for visibility) -->
            <div
              class="border border-red-100 dark:border-red-900/30 p-4 bg-red-50 dark:bg-red-900/10 rounded-lg"
            >
              <div
                class="flex items-center gap-2 mb-2 text-red-800 dark:text-red-300 font-bold text-sm"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
                <span class="uppercase tracking-wider text-xs">Disclaimer</span>
              </div>
              <p
                class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed mb-2"
              >
                Information is for educational purposes only. Consult a
                healthcare professional.
              </p>
              <a
                href="/disclaimer"
                class="text-[10px] text-red-700 dark:text-red-400 font-bold hover:underline uppercase tracking-wide"
                >Read Full Policy &rarr;</a
              >
            </div>

            {
              headings.length > 0 && (
                <nav class="border-t border-b border-neutral-100 dark:border-neutral-800 py-4 lg:border-0 lg:py-0">
                  <h2 class="font-bold text-xs uppercase tracking-widest mb-3 text-neutral-500 dark:text-neutral-400">
                    In This Article
                  </h2>
                  <ul class="space-y-2 text-sm">
                    {headings.map(
                      (heading: {
                        slug: string;
                        text: string;
                        depth: number;
                      }) => (
                        <li
                          class={`pl-${(heading.depth - 2) * 2} border-l-2 border-transparent hover:border-primary-600 transition-colors`}
                        >
                          <a
                            href={`#${heading.slug}`}
                            class="text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white block pl-2 line-clamp-1"
                          >
                            {heading.text}
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                </nav>
              )
            }
          </div>
        </aside>

        <!-- Main Content -->
        <main class="lg:w-3/4 order-1 lg:order-2 min-w-0">
          <!-- Article Header (Moved inside Main for denser layout) -->
          <header class="mb-8">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span
                class="font-bold uppercase tracking-widest text-xs text-white bg-primary-600 px-2 py-0.5"
              >
                {frontmatter.category}
              </span>
              <span
                class="text-xs font-bold text-neutral-400 uppercase tracking-wider"
              >
                {formatDate(frontmatter.pubDate)}
              </span>
            </div>

            <h1
              class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-4 text-neutral-900 dark:text-white leading-tight"
            >
              {frontmatter.title}
            </h1>

            <p
              class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-400 mb-6 font-light leading-snug"
            >
              {frontmatter.description}
            </p>

            <div
              class="flex items-center gap-3 py-4 border-y border-neutral-100 dark:border-neutral-800"
            >
              <div
                class="w-10 h-10 rounded-full bg-neutral-200 dark:bg-neutral-800 flex items-center justify-center text-lg"
              >
                {frontmatter.author ? frontmatter.author.charAt(0) : "H"}
              </div>
              <div class="flex flex-col">
                <span
                  class="font-bold text-sm text-neutral-900 dark:text-white uppercase tracking-wide"
                >
                  {frontmatter.author || "Health Focus Team"}
                </span>
                <span class="text-xs text-neutral-500">
                  {Math.ceil(readingTime)} min read
                </span>
              </div>
              <div class="ml-auto flex gap-2">
                {/* Share buttons placeholder or similar could go here */}
              </div>
            </div>
          </header>

          {
            frontmatter.image && (
              <div class="mb-8 rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                {typeof frontmatter.image === "string" ? (
                  <img
                    src={frontmatter.image}
                    alt={frontmatter.title}
                    class="w-full h-auto object-cover"
                  />
                ) : (
                  <Image
                    src={frontmatter.image}
                    alt={frontmatter.title}
                    class="w-full h-auto object-cover"
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 75vw, 1200px"
                    format="webp"
                    priority={true}
                  />
                )}
              </div>
            )
          }

          <div class="prose-custom max-w-none">
            <slot />
          </div>

          <!-- Tags -->
          <div
            class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800"
          >
            <div class="flex flex-wrap gap-2">
              {
                frontmatter.tags.map((tag: string) => (
                  <span class="text-neutral-500 dark:text-neutral-400 text-xs border border-neutral-200 dark:border-neutral-700 px-2 py-1 uppercase tracking-wide hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                    #{tag}
                  </span>
                ))
              }
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Related Posts -->
    {
      relatedPosts.length > 0 && (
        <section class="container-custom mt-16 lg:mt-24 mb-12 border-t border-neutral-200 dark:border-neutral-800 pt-12">
          <h2 class="font-display font-bold text-3xl mb-8 border-l-4 border-primary-600 pl-4 py-1">
            Read Next
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedPosts.map((post) => (
              <NewsCard post={post} variant="default" />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <slot name="newsletter" />
</BaseLayout>
<style>
  /* Smooth scroll for TOC links */
  html {
    scroll-behavior: smooth;
  }
</style>
