---
import BaseLayout from "./BaseLayout.astro";
import Newsletter from "../components/Newsletter.astro";
import BlogCard from "../components/BlogCard.astro";
import { formatDate } from "../utils/formatDate";
import { generateArticleSchema } from "../utils/schema";
import { getRelatedPosts } from "../utils/relatedPosts";
import { calculateReadingTime } from "../utils/readingTime";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    category: string;
    tags: string[];
    image?: string | ImageMetadata;
  };
  headings: { depth: number; text: string; slug: string }[];
  readingTime: number;
  relatedPosts?: any[];
}

const { frontmatter, headings, readingTime, relatedPosts = [] } = Astro.props;

const schema = generateArticleSchema({
  title: frontmatter.title,
  description: frontmatter.description,
  image:
    typeof frontmatter.image === "string"
      ? frontmatter.image
      : frontmatter.image?.src || "",
  datePublished: frontmatter.pubDate.toISOString(),
  dateModified:
    frontmatter.updatedDate?.toISOString() || frontmatter.pubDate.toISOString(),
  author: frontmatter.author,
});
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={typeof frontmatter.image === "string"
    ? frontmatter.image
    : frontmatter.image?.src}
  schema={schema}
>
  <article class="pt-8 pb-16">
    <!-- Header -->
    <header class="container-custom mb-12 text-center max-w-4xl mx-auto">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-sm font-semibold mb-6"
      >
        <span class="capitalize">{frontmatter.category}</span>
      </div>

      <h1
        class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 text-balance"
      >
        {frontmatter.title}
      </h1>

      <p class="text-xl text-neutral-600 mb-8 max-w-2xl mx-auto text-balance">
        {frontmatter.description}
      </p>

      <div
        class="flex flex-wrap items-center justify-center gap-6 text-sm text-neutral-500 dark:text-neutral-400"
      >
        <!-- Author Info -->
        <div class="flex items-center gap-2">
          <div
            class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 font-bold flex items-center justify-center"
          >
            {frontmatter.author ? frontmatter.author.charAt(0) : "H"}
          </div>
          <div class="text-left">
            <p class="font-semibold text-neutral-900 dark:text-white">
              {frontmatter.author || "Health Focus Team"}
            </p>
            <p class="text-xs">Contributor</p>
          </div>
        </div>
      </div>
    </header>

    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Sidebar (Table of Contents + Disclaimer) -->
        <aside class="lg:w-1/4 order-2 lg:order-1">
          <div class="sticky top-24 space-y-8">
            {
              headings.length > 0 && (
                <nav class="p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-100 dark:border-neutral-700">
                  <h2 class="font-bold text-lg mb-4 text-neutral-900 dark:text-white">
                    Table of Contents
                  </h2>
                  <ul class="space-y-3 text-sm">
                    {headings.map(
                      (heading: {
                        slug: string;
                        text: string;
                        depth: number;
                      }) => (
                        <li class={`pl-${(heading.depth - 2) * 4}`}>
                          <a
                            href={`#${heading.slug}`}
                            class="text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors block py-1"
                          >
                            {heading.text}
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                </nav>
              )
            }

            <!-- Sticky Medical Disclaimer -->
            <div
              class="p-6 rounded-2xl bg-accent-50 dark:bg-accent-900/10 border border-accent-100 dark:border-accent-800/30"
            >
              <div
                class="flex items-center gap-2 mb-3 text-accent-700 dark:text-accent-300 font-bold"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
                Medical Disclaimer
              </div>
              <p
                class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3"
              >
                Content is for informational purposes only and does not
                constitute medical advice. Always consult with a healthcare
                professional before making health changes.
              </p>
              <a
                href="/disclaimer"
                class="text-xs text-accent-600 dark:text-accent-400 font-medium hover:underline"
                >Read full disclaimer &rarr;</a
              >
            </div>
          </div>
        </aside>

        <!-- Main Content -->
        <main class="lg:w-3/4 order-1 lg:order-2">
          {
            frontmatter.image && (
              <div class="mb-12 rounded-3xl overflow-hidden shadow-lg">
                {typeof frontmatter.image === "string" ? (
                  <img
                    src={frontmatter.image}
                    alt={frontmatter.title}
                    class="w-full h-[400px] object-cover"
                  />
                ) : (
                  <Image
                    src={frontmatter.image}
                    alt={frontmatter.title}
                    class="w-full h-[400px] object-cover"
                    format="webp"
                    width={1200}
                    height={600}
                  />
                )}
              </div>
            )
          }

          <div class="prose-custom max-w-none">
            <slot />
          </div>

          <!-- Tags -->
          <div
            class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-700"
          >
            <div class="flex flex-wrap gap-2">
              {
                frontmatter.tags.map((tag: string) => (
                  <span class="px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 text-sm hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-default">
                    #{tag}
                  </span>
                ))
              }
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Related Posts -->
    {
      relatedPosts.length > 0 && (
        <section class="container-custom mt-24 mb-12">
          <h2 class="font-display font-bold text-3xl mb-8 border-b border-neutral-200 pb-4">
            Read Next
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                category={post.data.category}
                pubDate={post.data.pubDate}
                readingTime={calculateReadingTime(post.body)}
                image={post.data.image}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <slot name="newsletter" />
</BaseLayout>
<style>
  /* Smooth scroll for TOC links */
  html {
    scroll-behavior: smooth;
  }
</style>
