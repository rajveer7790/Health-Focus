---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="404 - Page Not Found"
    description="The page you are looking for does not exist."
>
    <section
        class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4"
    >
        <span class="text-primary-600 font-bold text-6xl md:text-8xl mb-4"
            >404</span
        >
        <h1
            class="text-3xl md:text-4xl font-display font-bold text-neutral-900 dark:text-white mb-6"
        >
            Page Not Found
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-md mb-8">
            Oops! The page you're looking for seems to have wandered off. Let's
            get you back on track.
        </p>
        <a href="/" class="btn btn-primary"> Return Home </a>
    </section>
</BaseLayout>
