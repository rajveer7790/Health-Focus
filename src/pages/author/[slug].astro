---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import Newsletter from "../../components/Newsletter.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../../utils/readingTime";

import { SITE_CONFIG } from "../../utils/seo";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const allPosts = await getCollection("blog");

  return authors.map((author) => ({
    params: { slug: author.slug },
    props: {
      author,
      posts: allPosts
        .filter(
          (post) => !post.data.draft && post.data.author === author.data.name,
        )
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { author, posts } = Astro.props;
const { name, role, bio, avatar, credentials, social } = author.data;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: name,
    description: bio,
    image: avatar,
    jobTitle: role,
    url: `${SITE_CONFIG.url}/author/${author.slug}`,
    sameAs: [social?.twitter, social?.linkedin, social?.website].filter(
      Boolean,
    ),
  },
};
---

<BaseLayout
  title={`${name} - ${role} | Health Focus`}
  description={`Read articles by ${name}, ${role} at Health Focus. ${bio}`}
  schema={schema}
>
  <section
    class="section-padding bg-gradient-to-br from-primary-50/50 via-white to-accent-50/50"
  >
    <div class="container-custom">
      <div
        class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 md:gap-12"
      >
        <!-- Avatar -->
        <div class="relative shrink-0">
          <div
            class="w-48 h-48 rounded-full overflow-hidden border-4 border-white shadow-xl bg-neutral-200"
          >
            <!-- Placeholder for avatar if image missing -->
            {
              avatar ? (
                <img
                  src={avatar}
                  alt={name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-primary-100 text-primary-600 font-display font-bold text-5xl">
                  {name.charAt(0)}
                </div>
              )
            }
          </div>
          <div
            class="absolute bottom-2 right-2 w-10 h-10 bg-success-500 rounded-full border-4 border-white flex items-center justify-center"
            title="Verified Author"
          >
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>

        <!-- Info -->
        <div class="text-center md:text-left flex-1">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-sm font-semibold mb-4 mx-auto md:mx-0"
          >
            {role}
          </div>

          <h1 class="font-display font-bold text-4xl md:text-5xl mb-2">
            {name}
            {
              credentials && (
                <span class="text-2xl text-neutral-500 font-normal ml-2">
                  {credentials}
                </span>
              )
            }
          </h1>

          <p class="text-lg text-neutral-600 mb-6 leading-relaxed">
            {bio}
          </p>

          <div class="flex items-center justify-center md:justify-start gap-4">
            {
              social?.twitter && (
                <a
                  href={social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-white border border-neutral-200 hover:border-primary-300 hover:text-primary-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                  </svg>
                </a>
              )
            }
            {
              social?.linkedin && (
                <a
                  href={social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-white border border-neutral-200 hover:border-primary-300 hover:text-primary-600 transition-colors"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                </a>
              )
            }
            {
              social?.website && (
                <a
                  href={social.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-white border border-neutral-200 hover:border-primary-300 hover:text-primary-600 transition-colors"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <h2
        class="font-display font-bold text-3xl mb-8 border-b border-neutral-200 pb-4"
      >
        Articles by {name.split(" ")[0]}
      </h2>

      {
        posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                category={post.data.category}
                pubDate={post.data.pubDate}
                readingTime={calculateReadingTime(post.body)}
                image={post.data.image}
              />
            ))}
          </div>
        ) : (
          <p class="text-neutral-600">No articles published yet.</p>
        )
      }
    </div>
  </section>

  <Newsletter />
</BaseLayout>
