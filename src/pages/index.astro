---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroGrid from "../components/HeroGrid.astro";
import NewsCard from "../components/NewsCard.astro";
import SectionDivider from "../components/SectionDivider.astro";
import Newsletter from "../components/Newsletter.astro";
import { getCollection } from "astro:content";
import { generateWebSiteSchema } from "../utils/schema";

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter out drafts and sort by date
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Distribution for News Layout
// 1 Main Hero (Center)
const mainPost = publishedPosts[0];

// 5 "More Top Stories" (Left Column)
const leftPosts = publishedPosts.slice(1, 6);

// 2 "Don't Miss" (Right Column)
const rightPosts = publishedPosts.slice(6, 8);

// Remaining posts for "Latest News" grid
const latestNewsPosts = publishedPosts.slice(8, 20);

// Specific Category: Lifestyle (Example for a section)
const lifestylePosts = publishedPosts
  .filter(
    (p) => p.data.category === "lifestyle" || p.data.category === "wellness",
  )
  .slice(0, 4);

const schema = generateWebSiteSchema();
---

<BaseLayout
  title="Health Focus: Global Health News & Wellness"
  description="Breaking health news, wellness strategies, and medical breakthroughs. Your trusted source for evidence-based health journalism."
  schema={schema}
  keywords={[
    "health news",
    "medical research",
    "wellness trends",
    "nutrition science",
    "mental health updates",
  ]}
>
  <!-- Hero Section -->
  <section
    class="border-b-4 border-double border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900"
  >
    <div class="container-custom pt-8 pb-8">
      <HeroGrid
        mainPost={mainPost}
        leftPosts={leftPosts}
        rightPosts={rightPosts}
      />
    </div>
  </section>

  <!-- Latest Articles Grid -->
  <section class="py-8 bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <SectionDivider title="Latest Health News" color="red" />

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10"
      >
        <!-- Main Feed (3 cols wide on LG) -->
        <div class="contents md:contents lg:col-span-3">
          <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:col-span-3 w-full"
          >
            {
              latestNewsPosts.map((post) => (
                <NewsCard post={post} variant="default" />
              ))
            }
          </div>
        </div>
      </div>

      <!-- Featured Series / Editors Picks -->
      <SectionDivider
        title="Editors' Picks: Wellness & Lifestyle"
        color="black"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          lifestylePosts.map((post) => (
            <NewsCard post={post} variant="overlay" />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />
</BaseLayout>
