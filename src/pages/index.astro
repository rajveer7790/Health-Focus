---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { CATEGORIES } from "../utils/seo";

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter out drafts and sort by date
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get featured posts
const featuredPosts = publishedPosts
  .filter((post) => post.data.featured)
  .slice(0, 1);
const recentPosts = publishedPosts.slice(0, 6);
---

<BaseLayout
  title="Health Focus | Your Health. Your Focus. Your Future."
  description="Practical guidance for building sustainable fitness and healthy habits in real life."
>
  <!-- Hero Section -->
  <section
    class="section-padding bg-gradient-to-br from-primary-50 via-white to-accent-50 dark:from-neutral-900 dark:via-neutral-900 dark:to-neutral-800 relative overflow-hidden transition-colors duration-300"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-20 left-10 w-72 h-72 bg-primary-300/20 dark:bg-primary-900/10 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-accent-300/20 dark:bg-accent-900/10 rounded-full blur-3xl animate-float"
        style="animation-delay: 1s;"
      >
      </div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="font-display font-bold text-5xl md:text-6xl lg:text-7xl mb-6 animate-slide-up text-neutral-900 dark:text-white"
        >
          Your Health. Your Focus.
          <span class="gradient-text">Your Future.</span>
        </h1>

        <p
          class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-300 mb-8 max-w-3xl mx-auto animate-slide-up text-balance"
          style="animation-delay: 0.1s;"
        >
          Practical guidance for building sustainable fitness and healthy habits in real life.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up"
          style="animation-delay: 0.2s;"
        >
          <a href="/blog" class="btn btn-primary text-lg px-8 py-4">
            Explore Articles
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a href="#newsletter" class="btn btn-secondary text-lg px-8 py-4">
            Get Weekly Tips
          </a>
        </div>

        <!-- Trust Signals -->
        <div
          class="mt-12 flex flex-wrap items-center justify-center gap-8 text-sm text-neutral-600 dark:text-neutral-400 animate-fade-in transition-colors duration-300"
          style="animation-delay: 0.3s;"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Evidence-Based</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Practical Advice</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>No Medical Claims</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section
    class="section-padding bg-white dark:bg-neutral-900 transition-colors duration-300"
  >
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2
          class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-4 text-neutral-900 dark:text-white"
        >
          Explore by Category
        </h2>
        <p
          class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto"
        >
          Find the health topics that matter most to you
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          CATEGORIES.map((category) => (
            <a
              href={`/category/${category.slug}`}
              class="card card-hover p-8 text-center group bg-white dark:bg-neutral-800 border-neutral-100 dark:border-neutral-700 hover:border-primary-200 dark:hover:border-primary-800"
            >
              <div class="text-6xl mb-4 transform group-hover:scale-110 transition-transform">
                {category.icon}
              </div>
              <h3 class="font-display font-bold text-xl mb-2 text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {category.name}
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400 text-sm">
                Explore {category.name.toLowerCase()} articles
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest Articles Section (Healthline Style) -->
  <section
    class="section-padding bg-white dark:bg-neutral-950 transition-colors duration-300"
  >
    <div class="container-custom">
      <div
        class="flex flex-col md:flex-row items-end justify-between gap-4 mb-12 border-b border-neutral-200 dark:border-neutral-800 pb-4"
      >
        <div>
          <h2
            class="font-display font-bold text-3xl md:text-4xl text-neutral-900 dark:text-white mb-2"
          >
            Latest from Health Focus
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400">
            Sustainable strategies for real-world fitness and wellness.
          </p>
        </div>
        <a
          href="/blog"
          class="text-primary-600 dark:text-primary-400 font-semibold hover:text-primary-700 dark:hover:text-primary-300 flex items-center gap-1 transition-colors"
        >
          View all
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <!-- Layout Grid -->
      <div class="space-y-12">
        <!-- Top Section: Hero + Secondary Feature -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          {/* Main Hero Article (Overlay Style) - Takes up approx 2/3 width */}
          <div class="lg:col-span-8">
            {
              publishedPosts[0] && (
                <BlogCard
                  title={publishedPosts[0].data.title}
                  description={publishedPosts[0].data.description}
                  slug={publishedPosts[0].slug}
                  category={publishedPosts[0].data.category}
                  pubDate={publishedPosts[0].data.pubDate}
                  readingTime={calculateReadingTime(publishedPosts[0].body)}
                  image={publishedPosts[0].data.image}
                  variant="overlay"
                />
              )
            }
          </div>

          {/* Secondary Feature (Regular Style) - Takes up approx 1/3 width */}
          <div class="lg:col-span-4">
            {
              publishedPosts[1] && (
                <BlogCard
                  title={publishedPosts[1].data.title}
                  description={publishedPosts[1].data.description}
                  slug={publishedPosts[1].slug}
                  category={publishedPosts[1].data.category}
                  pubDate={publishedPosts[1].data.pubDate}
                  readingTime={calculateReadingTime(publishedPosts[1].body)}
                  image={publishedPosts[1].data.image}
                  variant="regular"
                />
              )
            }
          </div>
        </div>

        <!-- Recent Grid: 4 Columns (Compact Style) -->
        <div>
          <h3
            class="font-bold text-xl text-neutral-900 dark:text-white mb-6 flex items-center gap-2"
          >
            <span class="w-1 h-6 bg-accent-500 rounded-full"></span>
            More Top Reads
          </h3>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10"
          >
            {
              publishedPosts
                .slice(2, 10)
                .map((post) => (
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    slug={post.slug}
                    category={post.data.category}
                    pubDate={post.data.pubDate}
                    readingTime={calculateReadingTime(post.body)}
                    image={post.data.image}
                    variant="compact"
                  />
                ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />
</BaseLayout>
