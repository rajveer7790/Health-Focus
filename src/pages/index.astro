---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { CATEGORIES } from "../utils/seo";

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter out drafts and sort by date
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get featured posts
const featuredPosts = publishedPosts
  .filter((post) => post.data.featured)
  .slice(0, 1);
const recentPosts = publishedPosts.slice(0, 6);
---

<BaseLayout
  title="Health Focus | Fitness & Wellness Blog for Sustainable Healthy Living"
  description="Discover practical fitness tips, nutrition advice, and wellness strategies for building sustainable healthy habits. Evidence-based guidance for real life—no quick fixes or fads."
  keywords={[
    "sustainable fitness habits",
    "wellness lifestyle blog",
    "practical health advice",
    "fitness for busy people",
    "healthy habits that last",
    "evidence-based fitness",
  ]}
>
  <!-- Hero Section -->
  <section
    class="section-padding min-h-[85vh] flex items-center justify-center bg-gradient-to-br from-primary-50 via-white to-accent-50 dark:from-neutral-900 dark:via-neutral-900 dark:to-neutral-800 relative overflow-hidden transition-colors duration-300"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-20 left-10 w-72 h-72 bg-primary-300/20 dark:bg-primary-900/10 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-accent-300/20 dark:bg-accent-900/10 rounded-full blur-3xl animate-float"
        style="animation-delay: 1s;"
      >
      </div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="font-display font-bold text-5xl md:text-6xl lg:text-7xl mb-6 animate-slide-up text-neutral-900 dark:text-white"
        >
          Building Sustainable
          <span class="gradient-text">Fitness & Wellness Habits</span>
          for Real Life
        </h1>

        <p
          class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-300 mb-8 max-w-3xl mx-auto animate-slide-up text-balance"
          style="animation-delay: 0.1s;"
        >
          Evidence-based guidance for busy people who want to get fit, stay
          healthy, and build habits that actually stick. No quick fixes—just
          practical strategies that work for your lifestyle.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up"
          style="animation-delay: 0.2s;"
        >
          <a href="/blog" class="btn btn-primary text-lg px-8 py-4">
            Explore Latest Articles
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a href="#newsletter" class="btn btn-secondary text-lg px-8 py-4">
            Get Weekly Wellness Tips
          </a>
        </div>

        <!-- Trust Signals -->
        <div
          class="mt-12 flex flex-wrap items-center justify-center gap-8 text-sm text-neutral-600 dark:text-neutral-400 animate-fade-in transition-colors duration-300"
          style="animation-delay: 0.3s;"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Evidence-Based</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Practical Advice</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-success-600 dark:text-success-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>No Medical Claims</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section
    class="section-padding bg-white dark:bg-neutral-950 transition-colors duration-300"
  >
    <div class="container-custom">
      <div
        class="flex flex-col md:flex-row items-end justify-between gap-4 mb-12 border-b border-neutral-200 dark:border-neutral-800 pb-4"
      >
        <div>
          <h2
            class="font-display font-bold text-3xl md:text-4xl text-neutral-900 dark:text-white mb-2"
          >
            Latest from Health Focus
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400">
            Sustainable strategies for real-world fitness and wellness.
          </p>
        </div>
        <a
          href="/blog"
          class="text-primary-600 dark:text-primary-400 font-semibold hover:text-primary-700 dark:hover:text-primary-300 flex items-center gap-1 transition-colors"
        >
          View all
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <!-- Simple Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          publishedPosts
            .slice(0, 6)
            .map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                category={post.data.category}
                pubDate={post.data.pubDate}
                readingTime={calculateReadingTime(post.body)}
                image={post.data.image}
                author={post.data.author}
              />
            ))
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />
</BaseLayout>
