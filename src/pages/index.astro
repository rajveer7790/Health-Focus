---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";
import { generateWebSiteSchema } from "../utils/schema";
import { CATEGORIES } from "../utils/seo";

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter out drafts and sort by date
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get featured post (latest 1) and scroll posts (next 5)
const latestPost = publishedPosts[0];
const scrollPosts = publishedPosts.slice(1, 6);

// Need Image for type checking if used inline
import { Image } from "astro:assets";

const schema = generateWebSiteSchema();
---

<BaseLayout
  title="Health Focus: Sustainable Fitness & Wellness Advice"
  description="Practical fitness tips, nutrition advice, and sustainable wellness strategies for real life. Build healthy habits with evidence-based guidance. No fads."
  schema={schema}
  keywords={[
    "sustainable fitness habits",
    "wellness lifestyle blog",
    "practical health advice",
    "fitness for busy people",
    "healthy habits that last",
    "evidence-based fitness",
  ]}
>
  <!-- Hero Section -->
  <section
    class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900"
  >
    <div class="container-custom py-8 md:py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12">
        <!-- Main Feature (Left, 8 cols) -->
        <div class="lg:col-span-8">
          {
            latestPost && (
              <a href={`/blog/${latestPost.slug}`} class="block group">
                <div class="relative overflow-hidden aspect-[16/9] mb-4 md:mb-6">
                  {latestPost.data.image &&
                    (typeof latestPost.data.image === "string" ? (
                      <img
                        src={latestPost.data.image}
                        alt={latestPost.data.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      />
                    ) : (
                      <Image
                        src={latestPost.data.image}
                        alt={latestPost.data.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        width={1200}
                        height={675}
                        loading="eager"
                        fetchpriority="high"
                      />
                    ))}
                </div>
                <div class="flex flex-col gap-2">
                  <span class="text-primary-700 dark:text-primary-400 font-bold uppercase tracking-wider text-xs md:text-sm">
                    {CATEGORIES.find((c) => c.slug === latestPost.data.category)
                      ?.name || latestPost.data.category}
                  </span>
                  <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-neutral-900 dark:text-white leading-tight group-hover:text-primary-700 dark:group-hover:text-primary-400 transition-colors">
                    {latestPost.data.title}
                  </h1>
                  <p class="text-neutral-600 dark:text-neutral-400 text-lg md:text-xl line-clamp-3 mt-2 font-light">
                    {latestPost.data.description}
                  </p>
                  <div class="flex items-center gap-3 text-sm text-neutral-500 mt-4">
                    <span class="font-bold text-neutral-900 dark:text-neutral-300">
                      {latestPost.data.author}
                    </span>
                    <span>•</span>
                    <span>
                      {new Date(latestPost.data.pubDate).toLocaleDateString(
                        "en-US",
                        { month: "long", day: "numeric", year: "numeric" },
                      )}
                    </span>
                  </div>
                </div>
              </a>
            )
          }
        </div>

        <!-- Top Stories Sidebar (Right, 4 cols) -->
        <div
          class="lg:col-span-4 flex flex-col gap-8 border-l border-neutral-200 dark:border-neutral-800 pl-0 lg:pl-12"
        >
          <h3
            class="font-display font-bold text-xl uppercase tracking-wider border-b-2 border-black dark:border-white pb-2 mb-4 inline-block self-start"
          >
            Top Stories
          </h3>
          <div
            class="flex flex-col divide-y divide-neutral-200 dark:divide-neutral-800"
          >
            {
              scrollPosts.slice(0, 4).map((post) => (
                <a href={`/blog/${post.slug}`} class="py-6 first:pt-0 group">
                  <span class="text-primary-700 dark:text-primary-400 font-bold text-xs uppercase tracking-wider mb-2 block">
                    {CATEGORIES.find((c) => c.slug === post.data.category)
                      ?.name || post.data.category}
                  </span>
                  <h4 class="font-display font-bold text-lg md:text-xl text-neutral-900 dark:text-white leading-snug group-hover:text-primary-700 dark:group-hover:text-primary-400 transition-colors mb-2">
                    {post.data.title}
                  </h4>
                  <div class="text-sm text-neutral-500">
                    {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                    })}
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles Grid -->
  <section class="py-12 md:py-16 bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <h3
        class="font-display font-bold text-2xl md:text-3xl text-neutral-900 dark:text-white mb-8 md:mb-12 border-b border-neutral-200 dark:border-neutral-800 pb-4"
      >
        More News
      </h3>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12"
      >
        {
          scrollPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              pubDate={post.data.pubDate}
              readingTime={calculateReadingTime(post.body)}
              image={post.data.image}
              author={post.data.author}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />
</BaseLayout>
