---
import BaseLayout from "../layouts/BaseLayout.astro";
import Newsletter from "../components/Newsletter.astro";
---

<BaseLayout
  title="Medical Disclaimer"
  description="Important medical disclaimer outlining the scope, limitations, and purpose of health and wellness content on Balanced Life Hubs."
>
  <!-- Hero -->
  <section class="section-padding bg-neutral-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6"
        >
          Medical Disclaimer
        </h1>
        <p class="text-xl text-neutral-600 max-w-2xl mx-auto">
          Important information about how health and wellness content on this
          website should be understood and used
        </p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div
          class="bg-white rounded-3xl shadow-lg border border-neutral-200 p-8 md:p-12"
        >
          <p class="text-lg text-neutral-700 mb-8 leading-relaxed">
            The information published on <strong>Health Focus</strong> (healthfocus.fit)
            is provided for
            <strong>educational and informational purposes only</strong>. It is
            intended to support general understanding of health and wellness
            topics and is <strong>not intended as medical advice</strong>.
          </p>

          <div class="space-y-10">
            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                Not a Substitute for Professional Medical Advice
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                Content on this website should not be used as a substitute for
                professional medical advice, diagnosis, or treatment. Always
                seek guidance from a qualified healthcare provider regarding any
                medical condition, symptoms, or health-related decisions.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                No Doctor–Patient Relationship
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                Accessing or using this website does <strong>not</strong> create a
                doctor–patient, clinician–patient, or healthcare provider relationship.
                While portions of our content are medically reviewed by board-certified
                physicians (our Medical Review Board) to ensure clinical accuracy,
                they are doing so in an editorial capacity, not a diagnostic one.
                The content creators, editors, and operators of this website are <strong
                  >not providing personalized medical services</strong
                >.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                Never Delay Seeking Medical Care
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                Never disregard or delay seeking professional medical advice
                because of something you have read on this website. If you
                believe you may be experiencing a medical emergency, contact
                your healthcare provider or local emergency services
                immediately.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                No Guarantees or Warranties
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                All information on this website is provided on an “as is” basis.
                We make no guarantees, representations, or warranties regarding
                the accuracy, completeness, reliability, or applicability of any
                information presented.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                Individual Results May Vary
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                Health, wellness, and lifestyle outcomes vary between
                individuals. Information and suggestions shared on this website
                may not be suitable for everyone and should be considered in the
                context of your personal health circumstances.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                External Links
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                This website may link to third-party websites for additional
                information or reference. Health Focus is not responsible for
                the content, accuracy, or practices of any external websites.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                Content Updates
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                Health information evolves over time. While we aim to keep our
                content accurate and current, we cannot guarantee that all
                information reflects the most recent research. This disclaimer
                may be updated periodically without prior notice.
              </p>
            </section>

            <section>
              <h2 class="font-display font-bold text-2xl text-neutral-900 mb-3">
                Contact
              </h2>
              <p class="text-neutral-700 leading-relaxed">
                If you have questions about this disclaimer or the content on
                this website, please visit our
                <a
                  href="/contact"
                  class="text-primary-600 hover:text-primary-700 underline font-medium"
                >
                  Contact page
                </a>.
              </p>
            </section>
          </div>

          <div class="mt-12 pt-8 border-t border-neutral-200">
            <p class="text-sm text-neutral-500">
              <strong>Last updated:</strong> February 22, 2026
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
